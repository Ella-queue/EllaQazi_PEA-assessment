@model W26HVKTEAM4.Models.Pet

@{
    ViewData["Title"] = "Delete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main>

    <h1>Delete</h1>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            <strong>Error:</strong> @ViewBag.ErrorMessage
        </div>
    }

    <h3>Are you sure you want to delete this?</h3>
    <div>
        <h4>Pet</h4>
        <hr />
        <dl class="row">
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Name)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Name)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Gender)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Gender)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Breed)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Breed)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Birthyear)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Birthyear)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.DogSize)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.DogSize)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Climber)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Climber)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Barker)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Barker)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.SpecialNotes)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.SpecialNotes)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Sterilized)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Sterilized)
            </dd>
            <dt class = "col-sm-2">
                Owner Name
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Hvkuser.FirstName) @Html.DisplayFor(model => model.Hvkuser.LastName)
            </dd>
        </dl>
    
        <form asp-action="Delete">
            <input type="hidden" asp-for="PetId" />
            <div>
                <input type="submit" value="Confirm Remove" class="btn btn-danger" />
            </div>
        </form>
    </div>
    <input type="hidden" asp-for="HvkuserId" />

    <div>
        <button onclick="location.href='@Url.Action("Index", new { id = Model.HvkuserId })'" class="btn btn-secondary">Back to Pets</button>
    </div>
</main>