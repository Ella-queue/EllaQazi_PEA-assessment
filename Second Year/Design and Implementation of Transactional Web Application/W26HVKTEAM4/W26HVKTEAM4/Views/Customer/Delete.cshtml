@model W26HVKTEAM4.Models.Hvkuser
<main>
    <h2>Are you sure you want to delete @Model.FirstName @Model.LastName?</h2>
    <form asp-action="Delete">
        <input type="hidden" asp-for="HvkuserId"/>
        <input type="submit" value="Delete User"/>
        <p style="color:red">@ViewBag.ErrorMessage</p>
        @if (ViewBag.UserType == "Employee")
        {
            <a asp-action="Index">Back to List</a>
        }
        @if(ViewBag.UserType == "Customer")
        {
            
            <a asp-action="Detail" asp-route-id="@Model.HvkuserId">Back to Profile</a>
        }
    </form>
</main>