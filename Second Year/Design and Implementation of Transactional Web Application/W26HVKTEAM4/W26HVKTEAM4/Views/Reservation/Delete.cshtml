@model W26HVKTEAM4.Models.Reservation

@{
    ViewData["Title"] = "Delete Reservation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<main>
    <div>
        <h2>Delete Reservation</h2>

        <p>Are you sure you want to delete this reservation?</p>

        <p>
            <strong>Dates:</strong> @Model.StartDate - @Model.EndDate
        </p>

        <h3>Pets in this reservation:</h3>

        @if (Model.PetReservations.Any())
        {
            <ul>
                @foreach (var pr in Model.PetReservations)
                {
                    <li>@pr.Pet.Name</li>
                }
            </ul>
        }
        else
        {
            <p>No pets linked to this reservation.</p>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="ReservationId" />
            <button class="delete-btn"type="submit">Yes, Delete</button>
            <a asp-controller="Reservation"
               asp-action="Index"
               class="remove-pet-service-btn">
                Cancel
            </a>
        </form>
    </div>
</main>