@{
    ViewData["Title"] = "Under Construction";
}

<main>
    <h2>Page Under Construction</h2>

    <p>This section of the Happy Valley Kennels system is coming soon.</p>

    <p>Please return to the Home page.</p>

    @if (ViewBag.User == "Employee")
    {
        <a asp-controller="Home" asp-action="Employee">Return to Homepage</a>
    }
    else
    {
        <a asp-controller="Home" asp-action="Customer" asp-route-customerId="@ViewData["CurrentlyLoggedInUser"]">Return to Homepage</a>
    }
</main>