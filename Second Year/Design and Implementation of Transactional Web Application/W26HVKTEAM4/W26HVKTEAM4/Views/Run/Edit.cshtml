@model W26HVKTEAM4.Models.Run

@{
    ViewData["Title"] = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<main>
<div>
<h3>Edit Run</h3>
        <form asp-action="Edit">
            <input type="hidden" asp-for="RunId" />
            <input type="hidden" asp-for="Size" />
            <input type="hidden" asp-for="Location" />
            <label class="form-check-label">
                <input class="form-check-input" asp-for="Covered" /> @Html.DisplayNameFor(model => model.Covered)
            </label>
            <label asp-for="Status" class="control-label"></label>
            <select asp-for="Status" class="form-control">
                <option value="1">Available</option>
                <option value="2">Needs Cleaning</option>
                <option value="3">Broken</option>
            </select>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>
</main>